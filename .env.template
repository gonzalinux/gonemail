# ─── Database ────────────────────────────────────────────────────────────────
# ecto://USER:PASS@HOST/DATABASE
DATABASE_URL=

# Number of DB connections per pool (default: 10)
POOL_SIZE=10

# Set to "true" to enable IPv6 database connections
ECTO_IPV6=false

# ─── Phoenix ─────────────────────────────────────────────────────────────────
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Public hostname (used for URL generation)
PHX_HOST=example.com

# HTTP port (default: 7777)
PORT=7777

# Set to "true" when running as a release (enables the HTTP server)
PHX_SERVER=true

# ─── SMTP ─────────────────────────────────────────────────────────────────────
# If unset, falls back to the local (dev) adapter
SMTP_RELAY=smtp.example.com
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Clustering (optional) ────────────────────────────────────────────────────
DNS_CLUSTER_QUERY=

# ─── Observability ───────────────────────────────────────────────────────────
LOG_AGGREGATOR_URL=
DEPLOY_ENV=production
